{
  "manifest_version": 3,
  "name": "Foevo — Attention Heatmap & AI Page Analysis",
  "version": "1.2.2",
  "description": "Scansiona una landing o scheda prodotto e genera una heatmap di attenzione + analisi AI orientata alla conversione.",
  "homepage_url": "https://foevo.app",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Foevo",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://foevo.app/*"
  ]
}