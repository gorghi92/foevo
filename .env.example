# ---- Foveo environment ----
# Public app URL (used for OAuth redirects, extension default endpoint, Whop return URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supabase (own project — separate from any other app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct (non-pooling) connection, used by the migration runner if you add one
POSTGRES_URL_NON_POOLING=

# ---- AI providers ----
# Premium tier (Claude vision)
ANTHROPIC_API_KEY=
ATTENTION_CLAUDE_MODEL=claude-opus-5
# Base tier (Qwen-VL via DashScope, OpenAI-compatible)
DASHSCOPE_API_KEY=
ATTENTION_QWEN_MODEL=qwen-vl-max
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1


# ---- Storage: Cloudflare R2 (S3-compatible). Optional: falls back to Supabase Storage ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=foveo-media
R2_ENDPOINT=
R2_PUBLIC_BASE=

# ---- Billing: Whop ----
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Optional hosted checkout base, e.g. https://whop.com/checkout
WHOP_CHECKOUT_BASE=

# ---- Superadmin (comma-separated emails) ----
SUPERADMIN_EMAILS=info@akmehub.com
